PostgreSQL HA Setup Script (Installation and replication)

```bash
#!/bin/bash
set -e

# Configuration variables
PRIMARY_IP=""  # Set this for replica nodes
NODE_TYPE=""   # Set to "primary" or "replica"
REPLICATOR_PWD="securepassword"
POSTGRES_VERSION="14"

# Validate input
if [[ "$NODE_TYPE" != "primary" && "$NODE_TYPE" != "replica" ]]; then
  echo "ERROR: NODE_TYPE must be 'primary' or 'replica'"
  exit 1
fi

if [[ "$NODE_TYPE" == "replica" && -z "$PRIMARY_IP" ]]; then
  echo "ERROR: PRIMARY_IP must be set for replica nodes"
  exit 1
fi

# Install PostgreSQL
install_postgres() {
  echo "Installing PostgreSQL..."
  apt-get update
  apt-get install -y postgresql-$POSTGRES_VERSION postgresql-contrib-$POSTGRES_VERSION ufw
}

# Configure basic PostgreSQL settings
configure_postgres() {
  echo "Configuring PostgreSQL..."

  cat > /etc/postgresql/$POSTGRES_VERSION/main/postgresql.conf <<EOF
listen_addresses = '*'
wal_level = replica
max_wal_senders = 3
max_replication_slots = 3
synchronous_commit = remote_apply
hot_standby = on
EOF

  cat > /etc/postgresql/$POSTGRES_VERSION/main/pg_hba.conf <<EOF
local   all             postgres                                peer
host    all             all             0.0.0.0/0               md5
host    replication     all             0.0.0.0/0               md5
EOF

  systemctl restart postgresql
}

# Setup primary node
setup_primary() {
  echo "Configuring primary node..."
  sudo -u postgres psql <<EOF
CREATE ROLE replicator WITH REPLICATION LOGIN PASSWORD '$REPLICATOR_PWD';
SELECT pg_create_physical_replication_slot('replica_slot');
CREATE DATABASE IF NOT EXISTS patient_records;
EOF
}

# Setup replica node
setup_replica() {
  echo "Configuring replica node..."
  systemctl stop postgresql || true
  rm -rf /var/lib/postgresql/$POSTGRES_VERSION/main/*

  sudo -u postgres pg_basebackup -h $PRIMARY_IP -D /var/lib/postgresql/$POSTGRES_VERSION/main \
    -U replicator -P -Xs -R -S replica_slot

  systemctl start postgresql
}

# Configure firewall
configure_firewall() {
  echo "Configuring firewall..."
  ufw allow 5432/tcp
  ufw allow ssh
  ufw --force enable
}

# Main execution
main() {
  if [ -f /var/lib/postgresql/configured ]; then
    echo "PostgreSQL already configured - skipping"
    return
  fi

  install_postgres
  configure_postgres
  configure_firewall

  if [[ "$NODE_TYPE" == "primary" ]]; then
    setup_primary
  else
    setup_replica
  fi

  touch /var/lib/postgresql/configured
  echo "PostgreSQL $NODE_TYPE node setup complete!"
}

main
```

Usage:
1. For primary node:
sudo NODE_TYPE=primary bash setup_postgres_ha.sh

2. For replica nodes:
sudo NODE_TYPE=replica PRIMARY_IP=<primary-ip-address> bash setup_postgres_ha.sh

Features:
- Installs and configures PostgreSQL
- Sets up streaming replication
- Configures firewall
- Idempotent (can be run multiple times)
- Validates input parameters
- Works for both primary and replica nodes

Notes:
- Requires Ubuntu/Debian
- Run with sudo
- Change REPLICATOR_PWD in script
- Set POSTGRES_VERSION if using different version
