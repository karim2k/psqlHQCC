PostgreSQL Automated Failover Script 

```bash
#!/bin/bash
# postgres_failover_system.sh
# Complete automated failover solution for PostgreSQL HA

set -euo pipefail

# Configuration Section
PRIMARY_IP="192.168.1.100"    # Current primary IP
REPLICA_IP="192.168.1.101"    # This server's IP
OTHER_REPLICAS=("192.168.1.102")  # Other replica IPs
LB_API="http://loadbalancer:8000/api/servers"
REPLICATOR_PWD="securepassword"

# Path configurations
PG_DATA="/var/lib/postgresql/14/main"
PG_VERSION="14"
TRIGGER_FILE="/var/lib/postgresql/failover.trigger"
LOCK_FILE="/tmp/postgres_failover.lock"
LOG_FILE="/var/log/postgresql/failover.log"

# Logging function
log() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> $LOG_FILE
}

# Primary health check
check_primary() {
    if ! pg_isready -h $PRIMARY_IP -p 5432 -t 3 >/dev/null 2>&1; then
        log "Primary node is down!"
        return 1
    fi
    
    if [ -f $PG_DATA/standby.signal ]; then
        lag=$(psql -h $PRIMARY_IP -U replicator -t -c "SELECT EXTRACT(SECOND FROM (now() - pg_last_xact_replay_timestamp()))" | tr -d ' ')
        
        if [ -z "$lag" ] || [ "$lag" -gt 15 ]; then
            log "High replication lag detected: ${lag} seconds"
            return 1
        fi
    fi
    
    return 0
}

# Promote this replica
promote_replica() {
    log "Promoting this replica to primary"
    sudo -u postgres pg_ctl promote -D $PG_DATA
    sleep 5
    
    for slot in replica1 replica2; do
        psql -c "SELECT pg_create_physical_replication_slot('$slot')"
    done
}

# Reconfigure other replicas
reconfigure_replicas() {
    for replica in "${OTHER_REPLICAS[@]}"; do
        log "Reconfiguring replica $replica"
        ssh -o StrictHostKeyChecking=no postgres@$replica "
            sudo systemctl stop postgresql
            rm -rf $PG_DATA/*
            sudo -u postgres pg_basebackup -h $REPLICA_IP -D $PG_DATA -U replicator -P -Xs -R -S replica1
            sudo systemctl start postgresql
        "
    done
}

# Update load balancer
update_load_balancer() {
    log "Updating load balancer configuration"
    curl -X PUT -d "server new-primary $REPLICA_IP:5432 check" $LB_API
}

# Cleanup after failover
cleanup_after_failover() {
    rm -f $TRIGGER_FILE
    log "Failover completed successfully"
}

# Main execution
main() {
    if [ ! -f $PG_DATA/standby.signal ]; then
        log "This is not a replica node. Exiting."
        exit 0
    fi
    
    if [ -f $LOCK_FILE ]; then
        log "Failover already in progress. Exiting."
        exit 0
    fi
    
    touch $LOCK_FILE
    trap 'rm -f $LOCK_FILE' EXIT
    
    if check_primary; then
        log "Primary node is healthy"
        exit 0
    fi
    
    if [ ! -f $TRIGGER_FILE ]; then
        touch $TRIGGER_FILE
        log "Trigger file created. Waiting for consensus..."
        sleep 20
        
        healthy_nodes=0
        for replica in "${OTHER_REPLICAS[@]}"; do
            if ssh postgres@$replica "test -f $TRIGGER_FILE"; then
                ((healthy_nodes++))
            fi
        done
        
        if [ $healthy_nodes -lt $((${#OTHER_REPLICAS[@]} / 2)) ]; then
            log "No consensus for failover. Aborting."
            rm -f $TRIGGER_FILE
            exit 1
        fi
    fi
    
    promote_replica
    reconfigure_replicas
    update_load_balancer
    cleanup_after_failover
}

main >> $LOG_FILE 2>&1
```

Key Features:

1. Health Monitoring:
- Checks primary node availability
- Monitors replication lag
- Uses pg_isready for connection testing

2. Safe Failover Process:
- Locking mechanism prevents multiple failovers
- Consensus system with other replicas
- Comprehensive logging

3. Automatic Recovery:
- Promotes replica to primary
- Reconfigures other replicas
- Updates load balancer automatically

4. Configuration:
- Set your node IPs at the top
- Adjust PG_DATA path if needed
- Configure load balancer API endpoint

Usage Instructions:

1. Deploy to all replica nodes:
scp postgres_failover_system.sh postgres@replica1:/usr/local/bin/
scp postgres_failover_system.sh postgres@replica2:/usr/local/bin/

2. Set execute permissions:
chmod +x /usr/local/bin/postgres_failover_system.sh

3. Add to cron (run every minute):
* * * * * /usr/local/bin/postgres_failover_system.sh

4. Monitor logs:
tail -f /var/log/postgresql/failover.log

Requirements:
- Password-less SSH between nodes
- Sudo access for postgres user
- Load balancer API access
- Identical PostgreSQL versions on all nodes

This script provides complete automated failover with safety checks to prevent split-brain scenarios. The solution is designed for production use with minimal dependencies.
